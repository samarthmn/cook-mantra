{
  "info": {
    "_postman_id": "7a4d38d4-4d7b-4d6b-a28c-59394a4a89fd",
    "name": "Cook Mantra API",
    "description": "Complete local Cook Mantra workflow: upload an ingredient image, review and confirm ingredients, generate recipe options, request more options, generate complete recipes, and optionally inspect a finished-dish preview.\n\nStart the API first, then run requests in numeric order. Background model operations are asynchronous. Repeat the matching Poll request until its `status` is `succeeded` before continuing.\n\nThe collection automatically captures session, job, and option IDs. After complete recipes are ready, it also captures the first available preview artifact ID. In request 04, select an ingredient image from your computer before sending.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({",
          "  key: 'X-Request-ID',",
          "  value: pm.variables.replaceIn('{{$guid}}')",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "job_status",
      "value": "",
      "type": "string"
    },
    {
      "key": "ingredients_payload",
      "value": "{\"ingredients\":[]}",
      "type": "string"
    },
    {
      "key": "confirmed_ingredient_count",
      "value": "2",
      "type": "string"
    },
    {
      "key": "option_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "available_option_ids_json",
      "value": "[]",
      "type": "string"
    },
    {
      "key": "selected_option_ids_json",
      "value": "[]",
      "type": "string"
    },
    {
      "key": "artifact_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "runtime_revision",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Service checks",
      "description": "Confirm that the API is running and all required model roles are ready, regardless of provider.",
      "item": [
        {
          "name": "01 Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API process is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health",
            "description": "Lightweight process health check."
          },
          "response": []
        },
        {
          "name": "02 Runtime Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Runtime status is safe and not cached', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "  pm.expect(['ok', 'attention']).to.include(body.status);",
                  "  pm.expect(body.runtime_revision).to.be.a('string');",
                  "  pm.expect(body.runtime_revision.length).to.be.within(32, 128);",
                  "  pm.expect(Object.keys(body).sort()).to.eql(['model_runtime', 'runtime_revision', 'status']);",
                  "});",
                  "pm.collectionVariables.set('runtime_revision', body.runtime_revision);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/runtime-status",
            "description": "Returns the safe, process-cached status for all four selected roles plus the immutable runtime revision used by local clients. The response is never cached. It includes selected provider/model identity and normalized role readiness, but no credentials, endpoints, commands, provider tags, raw inventories, or raw diagnostics."
          },
          "response": []
        },
        {
          "name": "03 Required Model Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Readiness returns its documented status', function () {",
                  "  pm.expect([200, 401, 402, 429, 502, 503, 504]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code !== 200) {",
                  "  console.warn('One or more required model roles are unavailable:', pm.response.json());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/ready",
            "description": "Returns 200 when every required model role is ready, regardless of provider. A safe non-200 response identifies authentication, payment, rate-limit, protocol, timeout, availability, model, or capability failure. The response retains a deprecated safe Ollama inventory for compatibility."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Ingredient extraction and confirmation",
      "description": "Upload an image, wait for extraction, review the returned ingredients, and confirm at least one.",
      "item": [
        {
          "name": "04 Create Session - Select Image First",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 409) {",
                  "  pm.test('Stale runtime status is rejected safely', function () {",
                  "    pm.expect(body.error.code).to.eql('runtime_status_stale');",
                  "  });",
                  "  pm.collectionVariables.set('session_id', '');",
                  "  pm.collectionVariables.set('job_id', '');",
                  "  pm.collectionVariables.set('job_status', '');",
                  "  console.warn('Refresh request 02, re-evaluate disclosure, then resend request 04.');",
                  "} else {",
                  "  pm.test('Ingredient extraction was queued', function () {",
                  "    pm.response.to.have.status(202);",
                  "  });",
                  "  pm.collectionVariables.set('session_id', body.session_id);",
                  "  pm.collectionVariables.set('job_id', body.job_id);",
                  "  pm.collectionVariables.set('job_status', 'queued');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Cook-Mantra-Runtime-Revision",
                "value": "{{runtime_revision}}",
                "type": "text",
                "description": "Required for browser photo uploads. Origin-less direct API clients may omit it and remain responsible for their own disclosure."
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Choose a JPEG, PNG, or WebP ingredient image. Maximum size: 10 MB."
                }
              ]
            },
            "url": "{{base_url}}/api/v1/sessions",
            "description": "Before sending, click the image value and select a local ingredient photo. Browser uploads send the revision captured by request 02. This process token is concurrency metadata, not consent; users must still review the disclosure. Origin-less direct API clients remain responsible for their own disclosure and may omit the header. A `runtime_status_stale` response means request 02 must be refreshed and disclosure re-evaluated before manually resending; the collection does not blindly replay uploads. On success, the test script saves `session_id` and `job_id` automatically."
          },
          "response": []
        },
        {
          "name": "05 Poll Ingredient Extraction Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job was found', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_status', body.status);",
                  "console.log('Ingredient extraction job status:', body.status);",
                  "if (body.status === 'failed') {",
                  "  console.error('Ingredient extraction failed:', body.error);",
                  "}",
                  "if (['queued', 'running'].includes(body.status)) {",
                  "  console.warn('Send this request again before continuing.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/jobs/{{job_id}}",
            "description": "Repeat until `status` is `succeeded`. The selected vision provider may take time."
          },
          "response": []
        },
        {
          "name": "06 Get Extracted Ingredients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session is ready for ingredient review', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().stage).to.eql('reviewing_ingredients');",
                  "});",
                  "const body = pm.response.json();",
                  "const requestedCount = Number(pm.collectionVariables.get('confirmed_ingredient_count') || 2);",
                  "const confirmedCount = Math.max(1, Math.min(requestedCount, body.ingredients.length));",
                  "const ingredients = body.ingredients.map(function (ingredient, index) {",
                  "  return {",
                  "    id: ingredient.id,",
                  "    name: ingredient.name,",
                  "    confirmed: index < confirmedCount",
                  "  };",
                  "});",
                  "pm.collectionVariables.set('ingredients_payload', JSON.stringify({ ingredients }));",
                  "console.log('Prepared ingredient review payload:', ingredients);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}",
            "description": "Reads extracted ingredients and prepares the next request automatically. By default, the first two ingredients are selected. Change `confirmed_ingredient_count` in collection variables if needed."
          },
          "response": []
        },
        {
          "name": "07 Update Ingredient Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ingredient review was saved', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().stage).to.eql('reviewing_ingredients');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{ingredients_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}/ingredients",
            "description": "Sends the review payload prepared by request 06. Inspect or edit the `ingredients_payload` collection variable before sending if you want different names or selections."
          },
          "response": []
        },
        {
          "name": "08 Confirm Ingredients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ingredients were confirmed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().stage).to.eql('ingredients_confirmed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}/ingredients/confirm",
            "description": "Locks the selected ingredients for recipe generation. At least one ingredient must be confirmed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Recipe options",
      "description": "Generate the first option batch, inspect the choices, and optionally generate another non-duplicate batch.",
      "item": [
        {
          "name": "09 Generate Recipe Options",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recipe option generation was queued', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_id', body.job_id);",
                  "pm.collectionVariables.set('job_status', 'queued');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dietary_preferences\": [\"vegetarian\"],\n  \"allergens\": [],\n  \"preferred_cuisines\": [\"Indian\"],\n  \"spice_level\": \"medium\",\n  \"special_instructions\": \"Use less oil and finish with fresh herbs.\",\n  \"max_total_minutes\": 45,\n  \"servings\": 2,\n  \"option_count\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}/recipe-options",
            "description": "Edit the JSON preferences as needed. spice_level accepts mild, medium, hot, or extra-hot; special_instructions accepts up to 500 characters. The accepted limits are 1-12 servings and 1-6 options."
          },
          "response": []
        },
        {
          "name": "10 Poll Recipe Options Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job was found', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_status', body.status);",
                  "console.log('Recipe options job status:', body.status);",
                  "if (body.status === 'failed') {",
                  "  console.error('Recipe option generation failed:', body.error);",
                  "}",
                  "if (['queued', 'running'].includes(body.status)) {",
                  "  console.warn('Send this request again before continuing.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/jobs/{{job_id}}",
            "description": "Repeat until `status` is `succeeded`. Recipe option generation runs in the background and may take longer than a normal request."
          },
          "response": []
        },
        {
          "name": "11 Get Options and Capture IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recipe options are ready', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().stage).to.eql('options_ready');",
                  "  pm.expect(pm.response.json().recipe_options.length).to.be.above(0);",
                  "});",
                  "const body = pm.response.json();",
                  "const availableIds = body.recipe_options.map(function (option) { return option.id; });",
                  "pm.collectionVariables.set('option_id', availableIds[0]);",
                  "pm.collectionVariables.set('available_option_ids_json', JSON.stringify(availableIds));",
                  "console.table(body.recipe_options.map(function (option) { return { id: option.id, name: option.name }; }));",
                  "console.warn('Before request 16, copy only the IDs you want into selected_option_ids_json.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}",
            "description": "Lists every generated option and captures their IDs in `available_option_ids_json`. In the collection variables, manually set `selected_option_ids_json` to only the one or more IDs you want to turn into complete recipes. The selection remains empty by default."
          },
          "response": []
        },
        {
          "name": "13 Generate More Recipe Options",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Additional option generation was queued', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_id', body.job_id);",
                  "pm.collectionVariables.set('job_status', 'queued');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dietary_preferences\": [\"vegetarian\"],\n  \"allergens\": [],\n  \"preferred_cuisines\": [\"Indian\"],\n  \"spice_level\": \"medium\",\n  \"special_instructions\": \"Use less oil and finish with fresh herbs.\",\n  \"max_total_minutes\": 45,\n  \"servings\": 2,\n  \"option_count\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}/recipe-options/more",
            "description": "Optional. Generates another batch while excluding every recipe name already shown in this session. Supports the same spice_level and special_instructions preferences as the initial batch."
          },
          "response": []
        },
        {
          "name": "14 Poll More Options Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job was found', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_status', body.status);",
                  "console.log('More options job status:', body.status);",
                  "if (body.status === 'failed') {",
                  "  console.error('Additional option generation failed:', body.error);",
                  "}",
                  "if (['queued', 'running'].includes(body.status)) {",
                  "  console.warn('Send this request again before continuing.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/jobs/{{job_id}}",
            "description": "If you sent request 13, repeat this request until `status` is `succeeded`."
          },
          "response": []
        },
        {
          "name": "15 Refresh Options and Selected IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recipe options remain ready', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().stage).to.eql('options_ready');",
                  "});",
                  "const body = pm.response.json();",
                  "const availableIds = body.recipe_options.map(function (option) { return option.id; });",
                  "pm.collectionVariables.set('option_id', availableIds[0]);",
                  "pm.collectionVariables.set('available_option_ids_json', JSON.stringify(availableIds));",
                  "console.table(body.recipe_options.map(function (option) { return { id: option.id, name: option.name }; }));",
                  "console.warn('Review selected_option_ids_json before request 16; it is never auto-filled.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}",
            "description": "Refreshes `available_option_ids_json` after the optional additional batch without changing your manual `selected_option_ids_json` selection."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Complete recipes",
      "description": "Generate full recipes for the selected option IDs, inspect successes or partial failures, and optionally retrieve a finished-dish preview.",
      "item": [
        {
          "name": "16 Generate Complete Recipes",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const selectedIds = JSON.parse(pm.collectionVariables.get('selected_option_ids_json') || '[]');",
                  "const availableIds = JSON.parse(pm.collectionVariables.get('available_option_ids_json') || '[]');",
                  "if (!Array.isArray(selectedIds) || selectedIds.length < 1 || selectedIds.length > 6) {",
                  "  console.error('Set selected_option_ids_json to a JSON array containing 1-6 option IDs from request 11 or 15.');",
                  "  pm.execution.skipRequest();",
                  "}",
                  "const unknownIds = selectedIds.filter(function (id) { return !availableIds.includes(id); });",
                  "if (unknownIds.length > 0) {",
                  "  console.error('selected_option_ids_json contains unknown IDs: ' + unknownIds.join(', '));",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Complete recipe generation was queued', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_id', body.job_id);",
                  "pm.collectionVariables.set('job_status', 'queued');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_ids\": {{selected_option_ids_json}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}/recipes",
            "description": "Queues full recipe generation only for IDs you manually placed in `selected_option_ids_json`. Request 11 or 15 prints every available option ID and name. Select between one and six IDs."
          },
          "response": []
        },
        {
          "name": "17 Poll Complete Recipes Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job was found', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_status', body.status);",
                  "console.log('Complete recipes job status:', body.status);",
                  "if (body.status === 'failed') {",
                  "  console.error('Complete recipe generation failed:', body.error);",
                  "}",
                  "if (['queued', 'running'].includes(body.status)) {",
                  "  console.warn('Send this request again before continuing.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/jobs/{{job_id}}",
            "description": "Repeat until `status` is `succeeded`. A succeeded job can contain both generated recipe IDs and failed option IDs."
          },
          "response": []
        },
        {
          "name": "18 Get Final Session and Recipes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('At least one complete recipe is ready', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.stage).to.eql('recipes_ready');",
                  "  pm.expect(Object.keys(body.complete_recipes).length).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('artifact_id', '');",
                  "const body = pm.response.json();",
                  "const firstPreview = Object.values(body.complete_recipes).find(function (recipe) {",
                  "  return recipe.preview && recipe.preview.artifact_id;",
                  "});",
                  "if (firstPreview) {",
                  "  pm.collectionVariables.set('artifact_id', firstPreview.preview.artifact_id);",
                  "}",
                  "console.log('Complete recipes:', body.complete_recipes);",
                  "console.log('Per-option failures:', body.recipe_failures);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/sessions/{{session_id}}",
            "description": "Returns complete recipes keyed by option ID plus any per-option failures. Partial success is preserved."
          },
          "response": []
        },
        {
          "name": "19 Get First Completed Recipe Preview",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const artifactId = pm.collectionVariables.get('artifact_id');",
                  "if (!artifactId || !artifactId.trim()) {",
                  "  console.warn('No completed recipe preview is available; skipping this optional request.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Completed recipe preview was returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\/(jpeg|png|webp)$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/artifacts/{{artifact_id}}",
            "description": "Optional. Returns the first completed recipe preview as binary image data when one was generated. Postman renders it in the response preview."
          },
          "response": []
        }
      ]
    }
  ]
