{
  "name": "@cook-mantra/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "format": "prettier --write .",
