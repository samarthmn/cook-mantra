LOG_LEVEL=INFO

# Required only when a role in config/cook-mantra.yaml selects OpenRouter.
# OpenRouter is remote; selected prompts, outputs, and vision media leave the machine.
# OPENROUTER_API_KEY=

# JSON array of exact browser origins allowed to call the local API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Must stay inside <project>/tmp; artifact cleanup deletes files under it.
# Secure local artifact storage supports macOS and Linux (with /proc mounted).
# ARTIFACT_ROOT=/absolute/path/to/cook-mantra/tmp/cook-mantra-api

# LangSmith is optional and never connects while disabled. When enabled, it
# receives bounded role/provider/model identity, job correlation, aggregate
# token usage, and vision summaries: media type, byte count, detected count, and
# warning count. LangSmith never receives prompts, model outputs, raw provider
# responses, or ingredient-image bytes/base64.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cook-mantra

# Opt-in smoke tests remain skipped unless these are explicitly set to 1.
# Read directly by the tests, not by Settings.
COOK_MANTRA_RUN_LIVE=0
COOK_MANTRA_RUN_LANGSMITH_LIVE=0
