# Copy to .env and adjust. No real secrets belong in this file.
#
# Only environment-specific values live here — things that differ between one
# machine and the next. Everything else (context window, timeouts, concurrency,
# image size, TTLs) is a product decision with a default in
# apps/api/src/core/config.py. Those remain overridable by setting the matching
# environment variable, but you should not need to.
#
# Agent-to-model assignments also live in config.py — change them there.
#
# The browser-facing API URL is NOT read from this file. Next.js only loads
# environment files under apps/web — see apps/web/.env.example.

# Where the text agents run. Required: there is no sensible default.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional; defaults to OLLAMA_BASE_URL. The dish-preview model
# (x/z-image-turbo) is MLX-only, so it runs only on Apple Silicon. Point this at
# such a host when the machine serving text cannot run it.
# OLLAMA_IMAGE_BASE_URL=http://127.0.0.1:11434

# Dish previews are off because the image model cannot run on a Linux Ollama
# host — it returns HTTP 500 for every request. Disabled means generation is
# skipped outright rather than failing once per recipe. Set to true once
# OLLAMA_IMAGE_BASE_URL points at an Apple Silicon host with the model pulled.
DISH_PREVIEWS_ENABLED=false

LOG_LEVEL=INFO

# JSON array of exact browser origins allowed to call the local API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Must stay inside <project>/tmp; artifact cleanup deletes files under it.
# Secure local artifact storage supports macOS and Linux (with /proc mounted).
# ARTIFACT_ROOT=/absolute/path/to/cook-mantra/tmp/cook-mantra-api

# LangSmith is optional and never connects while disabled. Enable it only when
# you accept that text-agent prompts and outputs will leave this machine.
# Ingredient-image bytes/base64 stay local; vision traces contain counts only.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cook-mantra

# Opt-in smoke tests remain skipped unless these are explicitly set to 1.
# Read directly by the tests, not by Settings.
COOK_MANTRA_RUN_LIVE=0
COOK_MANTRA_RUN_LANGSMITH_LIVE=0
