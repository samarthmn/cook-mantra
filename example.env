# Copy to .env and adjust. No real secrets belong in this file.
# Agent-to-model assignments live in
# apps/api/src/core/config.py — change them there, not here.

API_HOST=127.0.0.1
API_PORT=8000
# JSON array of exact browser origins allowed to call the local API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=300
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=4
MAX_CONCURRENT_MODEL_CALLS=2
CLEANUP_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
# Leave unset to use the image model's default number of steps.
# IMAGE_STEPS=20
IMAGE_TIMEOUT_SECONDS=600
SESSION_TTL_SECONDS=21600
# Secure local artifact storage supports macOS and Linux (with /proc mounted).
# ARTIFACT_ROOT=/absolute/path/to/cook-mantra/tmp/cook-mantra-api

# LangSmith is optional and never connects while disabled. Enable it only when
# you accept that text-agent prompts and outputs will leave this machine.
# Ingredient-image bytes/base64 stay local; vision traces contain counts only.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_pt_REDACTED
LANGSMITH_PROJECT=cook-mantra
# Opt-in smoke tests remain skipped unless this is explicitly set to 1.
COOK_MANTRA_RUN_LIVE=0
COOK_MANTRA_RUN_LANGSMITH_LIVE=0
